# Copy this file to .env and fill in real values before running the server
# for anything other than quick local testing. The app reads these as plain
# environment variables (via python-dotenv is NOT wired in by default — on
# your own machine you can `set`/`export` them, or use `python -m dotenv run`
# / your platform's env var settings; on Render, set them in the dashboard).

# REQUIRED. There is no default: if this is unset the server generates a
# random key for that process, so /editor.html cannot be signed into at all
# until you put a real value here. Anyone who has this key can add, edit, or
# delete content through /editor.html, so treat it like a password.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_KEY=

# Optional. Defaults to a local SQLite file (sqlite:///./portfolio.db).
# Set this to a Postgres connection string for storage that survives
# redeploys on hosts with an ephemeral filesystem (e.g. Render's free plan).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional, and only for the GitHub contribution heatmap. Without it the
# server asks GitHub anonymously, which is capped at 60 requests an hour —
# ample, because /api/github caches for 30 minutes and every visitor on
# every device reads that one cache. Set it and the ceiling becomes 5,000
# an hour, which is only worth doing if you point the heatmap at several
# accounts or refresh it constantly.
#
# A fine-grained token with NO scopes at all is enough: this only reads
# public profile counts. Make one at
#   github.com -> Settings -> Developer settings -> Personal access tokens
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Keeping a free instance awake
#
# Render spins a free web service down after 15 minutes without inbound
# traffic, and waking it takes about a minute. The app answers this by
# fetching its own public URL every few minutes, which counts as inbound
# traffic and stops the idle timer ever reaching 15.
#
# On Render this needs NO configuration: RENDER_EXTERNAL_URL is set for you
# and the heartbeat uses it. These are only for other hosts, or for turning
# it down.
#
# What to fetch. Off Render, set this to switch the heartbeat on. Point it at
# /api/health/db rather than /api/health — that one runs a SELECT, so the
# same request also keeps a Supabase project from pausing underneath you.
# KEEPALIVE_URL=https://your-service.onrender.com/api/health/db
#
# How often, in minutes. Default 7, clamped to 2-12. Seven means two
# consecutive misses still land inside the 15-minute window.
# KEEPALIVE_MINUTES=7
#
# Optional UTC window, e.g. 22-14 to run overnight and through the morning.
# A free workspace gets 750 instance-hours a month and a month is 730-744,
# so ONE always-on service fits. Add a second free service and it does not —
# that is when this becomes worth setting.
# KEEPALIVE_HOURS=
#
# Set to off/0/false to disable the heartbeat entirely.
# KEEPALIVE=on
#
# Whether it is actually working is readable at /api/health/awake.
