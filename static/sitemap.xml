<?xml version="1.0" encoding="UTF-8"?>
<!-- Only canonical URLs belong in a sitemap. /projects, /achievements, /tools
     and /chat are real, shareable routes, but they serve the same page as /
     and declare / as their canonical, so listing them only produced
     "Alternate page with proper canonical tag" notices in Search Console.
     The server replaces example.com with the real address. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://example.com/</loc><changefreq>weekly</changefreq><priority>1.0</priority></url>
</urlset>
